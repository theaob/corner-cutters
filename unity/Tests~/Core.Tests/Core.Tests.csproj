<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain console test runner, no NuGet packages: `dotnet run` from this folder. It compiles the engine-free core
       (Assets/Scripts/Core) as-is, so the C# the game ships is what's checked against the web game's golden traces. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
  </ItemGroup>
</Project>
